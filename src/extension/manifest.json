{
  "manifest_version": 2,
  "name": "zen-mcp",
  "version": "0.1.2",
  "description": "MCP server for Zen Browser automation",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "cookies",
    "<all_urls>"
  ],
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval'; object-src 'self'",
  "background": {
    "scripts": [
      "index.js",
      "bridge-connection.js",
      "network-capture.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "zen-mcp bridge settings",
    "default_popup": "settings/index.html"
  },
  "options_ui": {
    "page": "settings/index.html",
    "open_in_tab": false
  },
  "experiment_apis": {
    "zenMcp": {
      "schema": "experiment/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "script": "experiment/api.js",
        "paths": [["zenMcp"]]
      }
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "zen-mcp@example.com",
      "strict_min_version": "115.0"
    }
  }
}
